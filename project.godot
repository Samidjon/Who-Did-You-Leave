; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Кого ты оставил? (Who Did You Leave?)"
config/description="Психологический хоррор от первого лица. Вертикальный прототип."
config/version="0.1.0"
run/main_scene="res://scenes/menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Loc="*res://scripts/core/loc.gd"
Events="*res://scripts/core/events.gd"
Settings="*res://scripts/core/settings.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
DialogueManager="*res://scripts/narrative/dialogue_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Кого ты оставил- (Who Did You Leave-)"

[gui]

theme/custom="res://resources/ui_theme.tres"

